* text=auto
third_party/libmpv/include/** text eol=lf
*.ps1 text eol=crlf
# 带 SHA-256 锁定的上游许可与着色器必须保持原始字节；Windows checkout 不转换换行。
LICENSE -text
LICENSES/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/**/*.md -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/**/*.cmake -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
installer/ChineseSimplified.isl -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
*.ttf binary
*.ico binary
third_party/libmpv/libmpv.lock.json text eol=lf
LICENSES/native-sources.lock.json text eol=lf
LICENSES/msys2-native/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab conflict-marker-size=32
LICENSES/msys2-build/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab conflict-marker-size=32
LICENSES/msys2-rust/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab conflict-marker-size=32
