<UserControl
    x:Class="Mambo.App.Views.Controls.CardRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls"
    xmlns:themes="using:Mambo.App.Themes"
    xmlns:vm="using:Mambo.App.ViewModels"
    Visibility="{x:Bind Rail.IsVisible, Mode=OneWay}">
    <UserControl.Resources>
        <DataTemplate x:Key="PosterTemplate" x:DataType="vm:MediaCardViewModel">
            <controls:PosterCard Item="{x:Bind}"/>
        </DataTemplate>
        <DataTemplate x:Key="LandscapeTemplate" x:DataType="vm:MediaCardViewModel">
            <controls:LandscapeCard Item="{x:Bind}"/>
        </DataTemplate>
    </UserControl.Resources>
    <!-- 页边距 24；卡片行向两侧各多出 20，让滚动的卡片几乎贴到内容区边缘才被裁掉 -->
    <Grid Margin="0,0,0,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Height="28" Margin="24,0,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 标题本身就是"查看全部"：文字加一个箭头 -->
            <Button Style="{StaticResource RailLinkButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnLinkClick"
                    Visibility="{x:Bind Rail.HasLink, Mode=OneWay}" AutomationProperties.Name="{x:Bind Rail.LinkName, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" Text="{x:Bind Rail.Title, Mode=OneWay}"/>
                    <themes:LineIcon Glyph="{StaticResource IconChevronRight}" Width="17" Height="17" StrokeWidth="2.4" Foreground="{ThemeResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" Text="{x:Bind Rail.Title, Mode=OneWay}"
                       Visibility="{x:Bind Rail.HasNoLink, Mode=OneWay}"/>
            <StackPanel x:Name="Arrows" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="LeftArrow" Style="{StaticResource RailArrowButtonStyle}" Click="OnLeftClick" AutomationProperties.Name="{x:Bind Rail.ScrollLeftName, Mode=OneWay}">
                    <themes:LineIcon Glyph="{StaticResource IconChevronLeft}" Width="15" Height="15" StrokeWidth="2.35"/>
                </Button>
                <Button x:Name="RightArrow" Style="{StaticResource RailArrowButtonStyle}" Click="OnRightClick" AutomationProperties.Name="{x:Bind Rail.ScrollRightName, Mode=OneWay}">
                    <themes:LineIcon Glyph="{StaticResource IconChevronRight}" Width="15" Height="15" StrokeWidth="2.35"/>
                </Button>
            </StackPanel>
        </Grid>
        <ScrollView x:Name="Scroller" Grid.Row="1" Margin="4,-8,4,0" ContentOrientation="Horizontal" HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IgnoredInputKinds="MouseWheel"
                    ViewChanged="OnViewChanged" ExtentChanged="OnExtentChanged" SizeChanged="OnScrollerSizeChanged"
                    Visibility="{x:Bind Rail.HasItems, Mode=OneWay}">
            <ItemsRepeater x:Name="Repeater" Margin="20,8,20,8" ItemsSource="{x:Bind Rail.Items, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource RailSpacing}"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollView>
        <StackPanel x:Name="Skeleton" Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource RailSpacing}" Padding="24,0,24,8" Visibility="{x:Bind Rail.IsLoading, Mode=OneWay}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Padding="24,0,24,8" Visibility="{x:Bind Rail.HasError, Mode=OneWay}">
            <TextBlock Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"
                       Text="{x:Bind Rail.ErrorText, Mode=OneWay}"/>
            <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Click="OnRetryClick"/>
        </StackPanel>
    </Grid>
</UserControl>
