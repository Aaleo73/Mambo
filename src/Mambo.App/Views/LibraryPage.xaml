<UserControl
    x:Class="Mambo.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls"
    xmlns:themes="using:Mambo.App.Themes"
    xmlns:vm="using:Mambo.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:FilterChipViewModel">
            <ToggleButton Style="{StaticResource ChipStyle}" Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                          Tag="{x:Bind}" Click="OnChipClick"/>
        </DataTemplate>
        <!-- 筛选分组的标签：40 宽、右对齐、12 中等 -->
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MiSansMediumFontFamily}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CharacterSpacing" Value="20"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FilterRuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Background" Value="{ThemeResource RuleBrush}"/>
        </Style>
    </UserControl.Resources>
    <!-- 页头固定，只有网格滚动；滚动区在内容区底边上方 32 处结束 -->
    <Grid Padding="0,20,0,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,0">
            <controls:PageHeader Eyebrow="LIBRARY" Title="{x:Bind ViewModel.Title}" Count="{x:Bind ViewModel.CountText, Mode=OneWay}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="FilterButton" Style="{StaticResource IconPillToggleStyle}" Click="OnFilterClick" AutomationProperties.Name="筛选"
                                      ToolTipService.ToolTip="筛选">
                            <themes:LineIcon Glyph="{StaticResource IconFilter}" Width="16" Height="16" StrokeWidth="2"/>
                        </ToggleButton>
                        <Button Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center" Click="OnResetClick" AutomationProperties.Name="重置筛选"
                                Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}">
                            <TextBlock Text="重置" TextDecorations="Underline"/>
                        </Button>
                        <!-- 排序：胶囊在原位展开成弹出面，第一行就是当前排序 -->
                        <Grid Width="144" Height="{StaticResource PillHeight}">
                            <Button x:Name="SortButton" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Click="OnSortButtonClick">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <themes:LineIcon Glyph="{StaticResource IconSort}" Width="14" Height="14" StrokeWidth="2"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ButtonLabelTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}"/>
                                    <themes:LineIcon Grid.Column="2" Glyph="{StaticResource IconChevronDown}" Width="12" Height="12" StrokeWidth="2"/>
                                </Grid>
                            </Button>
                            <Popup x:Name="SortPopup" IsLightDismissEnabled="False" LightDismissOverlayMode="Off" Opened="OnSortPopupOpened" Closed="OnSortPopupClosed">
                                <Grid x:Name="SortSurface" Width="144">
                                    <Border CornerRadius="{StaticResource PopupCornerRadius}" themes:SoftShadow.Kind="Popup"/>
                                    <Border Style="{StaticResource PopupSurfaceStyle}">
                                        <StackPanel>
                                            <Button x:Name="SortHeader" Style="{StaticResource CardButtonStyle}" Height="{StaticResource PillHeight}" Click="OnSortHeaderClick">
                                                <Grid ColumnSpacing="6" Padding="11,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <themes:LineIcon Glyph="{StaticResource IconSort}" Width="14" Height="14" StrokeWidth="2" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Style="{StaticResource ButtonLabelTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}"/>
                                                    <themes:LineIcon Grid.Column="2" Glyph="{StaticResource IconChevronUp}" Width="12" Height="12" StrokeWidth="2"
                                                                     Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Button>
                                            <Border Height="1" Background="{ThemeResource PopupDividerBrush}"/>
                                            <StackPanel x:Name="SortOptions" Padding="4"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

        </StackPanel>

        <Grid x:Name="BodyHost" Grid.Row="1" SizeChanged="OnBodySizeChanged">
            <!-- 筛选面板：没有外框，上面一条细线，分组之间也用细线隔开；最多 180 高，超出滚动 -->
            <Border x:Name="FilterPanel" Margin="24,-4,24,12" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="0,1,0,0"
                    VerticalAlignment="Top" Visibility="Collapsed" SizeChanged="OnFilterSizeChanged">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="0,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FilterLabelStyle}" Text="类型"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.GenreChips}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><controls:WrapPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <Border Style="{StaticResource FilterRuleStyle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FilterLabelStyle}" Text="年份"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.DecadeChips}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><controls:WrapPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <Border Style="{StaticResource FilterRuleStyle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FilterLabelStyle}" Text="分级"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.RatingChips}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><controls:WrapPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        <ScrollViewer x:Name="Scroller" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" ViewChanged="OnScrollViewChanged">
            <!-- 上留 8：第一行卡片悬停上浮时不被裁掉 -->
            <StackPanel Padding="24,8,24,0">
                <!-- 海报随宽度缩放：列间距固定，卡片填满整行，图片保持 150:220 -->
                <ItemsRepeater x:Name="Grid" ItemsSource="{x:Bind ViewModel.Cards.Items, Mode=OneWay}"
                               XYFocusKeyboardNavigation="Enabled" SizeChanged="OnGridSizeChanged">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="{StaticResource PosterWidth}" MinColumnSpacing="{StaticResource GridColumnSpacing}"
                                           MinRowSpacing="{StaticResource GridRowSpacing}" ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaCardViewModel">
                            <controls:PosterCard Item="{x:Bind}" IsAdaptive="True"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <controls:WrapPanel x:Name="Skeleton" Spacing="20" Visibility="{x:Bind ViewModel.Cards.IsLoadingFirst, Mode=OneWay}"/>
                <!-- 加载下一页：一行骨架卡片，超出宽度的部分裁掉 -->
                <Grid x:Name="MoreSkeletonHost" Margin="0,24,0,0" Height="276" Visibility="{x:Bind ViewModel.Cards.IsLoadingMore, Mode=OneWay}">
                    <StackPanel x:Name="MoreSkeleton" Orientation="Horizontal" Spacing="{StaticResource GridColumnSpacing}" HorizontalAlignment="Left"/>
                </Grid>
                <Button Style="{StaticResource SoftButtonStyle}" Margin="0,24,0,8" HorizontalAlignment="Center" Content="重试加载" Click="OnLoadMoreClick"
                        Visibility="{x:Bind ViewModel.Cards.HasMoreError, Mode=OneWay}"/>

                <controls:StateView x:Name="FilteredEmptyState" Title="当前筛选没有内容" Visibility="{x:Bind ViewModel.ShowFilteredEmpty, Mode=OneWay}">
                    <controls:StateView.Actions>
                        <Button Style="{StaticResource SoftButtonStyle}" Content="重置筛选" Click="OnResetClick"/>
                    </controls:StateView.Actions>
                </controls:StateView>
                <controls:StateView x:Name="EmptyState" Title="暂无内容" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}"/>
                <controls:StateView x:Name="ErrorState" Title="资料库加载失败" Visibility="{x:Bind ViewModel.Cards.HasError, Mode=OneWay}">
                    <controls:StateView.Actions>
                        <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Click="OnRetryClick"/>
                    </controls:StateView.Actions>
                </controls:StateView>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
