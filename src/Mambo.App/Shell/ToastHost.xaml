<UserControl
    x:Class="Mambo.App.Shell.ToastHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Mambo.App.Shell"
    xmlns:themes="using:Mambo.App.Themes">
    <!-- 右下角，最多 384 宽；没有类型图标，重试按钮单独一行靠右 -->
    <ItemsControl ItemsSource="{x:Bind Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
        <ItemsControl.ItemContainerTransitions>
            <TransitionCollection>
                <AddDeleteThemeTransition/>
            </TransitionCollection>
        </ItemsControl.ItemContainerTransitions>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:ToastItem">
                <Grid Width="384">
                    <Border CornerRadius="{StaticResource PopupCornerRadius}" themes:SoftShadow.Kind="Popup"/>
                    <Border Style="{StaticResource PopupSurfaceStyle}" Padding="20,16,16,16" Tag="{x:Bind}"
                            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyTextStyle}" LineHeight="24" Margin="0,2,0,0" Text="{x:Bind Text}" TextWrapping="Wrap" TextTrimming="None"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top"
                                        AutomationProperties.Name="关闭" Tag="{x:Bind}" Click="OnCloseClick">
                                    <themes:LineIcon Glyph="{StaticResource IconClose}" Width="14" Height="14" StrokeWidth="2.4"/>
                                </Button>
                            </Grid>
                            <Button Style="{StaticResource SoftButtonStyle}" MinWidth="88" HorizontalAlignment="Right" Margin="0,0,4,0"
                                    Content="{x:Bind ActionText}" Visibility="{x:Bind HasAction}" Tag="{x:Bind}" Click="OnActionClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
