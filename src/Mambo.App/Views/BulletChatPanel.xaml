<UserControl
    x:Class="Mambo.App.Views.BulletChatPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mambo.App.ViewModels"
    xmlns:themes="using:Mambo.App.Themes"
    RequestedTheme="Dark" Width="320" AutomationProperties.Name="弹幕">
    <Grid Padding="16,12,16,14">
        <StackPanel x:Name="SettingsView" Spacing="4" Visibility="{x:Bind ViewModel.IsSettingsView, Mode=OneWay}">
            <Grid Height="40">
                <TextBlock Text="弹幕" Style="{StaticResource PlayerPanelHeader}"/>
                <ToggleSwitch x:Name="EnabledSwitch" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-8,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="显示弹幕"/>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="不透明度" Style="{StaticResource PlayerPanelLabel}"/>
                <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource PlayerPanelSlider}" Minimum="20" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="20"
                        Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}" AutomationProperties.Name="弹幕不透明度"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.OpacityText, Mode=OneWay}" Style="{StaticResource PlayerPanelValue}"/>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="字号" Style="{StaticResource PlayerPanelLabel}"/>
                <Slider x:Name="FontSlider" Grid.Column="1" Style="{StaticResource PlayerPanelSlider}" Minimum="60" Maximum="200" StepFrequency="10" SmallChange="10" LargeChange="20"
                        Value="{x:Bind ViewModel.FontPercent, Mode=TwoWay}" AutomationProperties.Name="弹幕字号"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.FontText, Mode=OneWay}" Style="{StaticResource PlayerPanelValue}"/>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="速度" Style="{StaticResource PlayerPanelLabel}"/>
                <Slider x:Name="SpeedSlider" Grid.Column="1" Style="{StaticResource PlayerPanelSlider}" Minimum="0" Maximum="4" StepFrequency="1" SmallChange="1" LargeChange="1"
                        Value="{x:Bind ViewModel.SpeedLevel, Mode=TwoWay}" AutomationProperties.Name="弹幕速度"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}" Style="{StaticResource PlayerPanelValue}"/>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="显示区域" Style="{StaticResource PlayerPanelLabel}"/>
                <Slider x:Name="AreaSlider" Grid.Column="1" Style="{StaticResource PlayerPanelSlider}" Minimum="10" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="25"
                        Value="{x:Bind ViewModel.AreaPercent, Mode=TwoWay}" AutomationProperties.Name="弹幕显示区域"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.AreaText, Mode=OneWay}" Style="{StaticResource PlayerPanelValue}"/>
            </Grid>
            <Border Height="1" Margin="0,8" Background="{ThemeResource PlayerHoverBrush}"/>
            <Grid ColumnSpacing="8" MinHeight="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource PlayerPanelLabel}" Foreground="{ThemeResource PlayerTextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="RetryButton" Grid.Column="1" Content="重试" Style="{StaticResource PlayerPanelButton}" Click="OnRetryClick"
                        Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" AutomationProperties.Name="重新加载弹幕"/>
                <Button x:Name="SearchButton" Grid.Column="2" Content="搜索" Style="{StaticResource PlayerPanelButton}" Click="OnSearchClick"
                        Visibility="{x:Bind ViewModel.CanSearch, Mode=OneWay}" AutomationProperties.Name="搜索弹幕"/>
            </Grid>
        </StackPanel>

        <Grid x:Name="SearchView" RowSpacing="10" Visibility="{x:Bind ViewModel.IsSearchView, Mode=OneWay}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="264"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource PlayerPanelButton}" Padding="0" Width="32" Click="OnBackClick" AutomationProperties.Name="返回" ToolTipService.ToolTip="返回">
                    <themes:LineIcon Glyph="{StaticResource IconChevronLeft}" Width="16" Height="16"/>
                </Button>
                <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="片名" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="100" KeyDown="OnSearchKeyDown" FontFamily="{StaticResource MiSansRegularFontFamily}" FontSize="13" AutomationProperties.Name="搜索弹幕"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource PlayerPanelHeader}" FontSize="13"
                       TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.HasHeading, Mode=OneWay}"/>
            <ListView x:Name="ResultList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRowClick"
                      Margin="-8,0" AutomationProperties.Name="搜索结果">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BulletChatRow">
                        <StackPanel Padding="0,6" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource PlayerPanelLabel}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource PlayerPanelLabel}" Foreground="{ThemeResource PlayerTextSecondaryBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasDetail}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing Grid.Row="2" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="{ThemeResource PlayerTextPrimaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource PlayerPanelLabel}" Foreground="{ThemeResource PlayerTextSecondaryBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</UserControl>
