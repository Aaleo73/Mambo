<UserControl
    x:Class="Mambo.App.Views.Controls.HeroInfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,32,12" MaxWidth="860">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="LogoArea" Width="360" Height="130">
                <Border x:Name="TitleShadow"/>
                <Image x:Name="LogoImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource HeroTitleTextStyle}"/>
            </Grid>
            <Grid x:Name="MetaArea" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,8">
                <Border x:Name="MetaShadow"/>
                <StackPanel x:Name="MetaRow" Orientation="Horizontal" Spacing="12"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Height="48" MaxWidth="672" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Border x:Name="OverviewShadow"/>
            <TextBlock x:Name="OverviewText" Style="{StaticResource HeroOverviewTextStyle}" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</UserControl>
