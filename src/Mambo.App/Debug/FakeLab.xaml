<UserControl
    x:Class="Mambo.App.Debug.FakeLab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:debug="using:Mambo.App.Debug"
    xmlns:video="using:Mambo.App.Video">
    <Grid Background="#171717" RequestedTheme="Dark" Padding="16" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="P1a · 假数据与契约演示" FontSize="22"/>
            <TextBlock Text="媒体、图片和播放进度由程序生成。可用于前端开发及加载态、错误态验证。" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="LibraryBox" ItemsSource="{x:Bind Libraries}" SelectionChanged="LibraryChanged" Width="220">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="debug:DemoLibraryRow"><TextBlock Text="{x:Bind Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="加载下一页" Click="MoreClicked"/>
                <Button Content="刷新" Click="RefreshClicked"/>
                <Button Content="预览 12 集连播" Click="PreviewClicked"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="CountText" Text="正在准备示例媒体库…"/>
            <ListView x:Name="ItemList" Grid.Row="1" ItemsSource="{x:Bind Items}" IsItemClickEnabled="True" ItemClick="MediaClicked">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="debug:DemoMediaRow">
                        <StackPanel Padding="4" Spacing="2">
                            <TextBlock Text="{x:Bind Name}"/>
                            <TextBlock Text="{x:Bind Overview}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Background="Black">
                <video:VideoSurface x:Name="DemoSurface"/>
                <TextBlock x:Name="PlaybackTitle" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Text="选择媒体开始假播放" TextWrapping="Wrap" Margin="20"/>
            </Grid>
            <TextBlock x:Name="PlaybackState" Grid.Row="1" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="播放 / 暂停" Click="PauseClicked"/>
                <Button Content="上一集" Click="PreviousClicked"/>
                <Button Content="下一集" Click="NextClicked"/>
                <Button Content="前进 30 秒" Click="SeekClicked"/>
                <Button Content="结束" Click="StopClicked"/>
            </StackPanel>
            <Image x:Name="GeneratedImage" Grid.Row="3" Height="120" Stretch="Uniform"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
