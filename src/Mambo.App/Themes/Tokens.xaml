    <!-- 播放层：始终深色，画面上方不用亚克力 -->
    <SolidColorBrush x:Key="PlayerTextPrimaryBrush" Color="#F5FFFFFF"/>
    <SolidColorBrush x:Key="PlayerTextSecondaryBrush" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="PlayerTextTertiaryBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="PlayerPanelBrush" Color="#EB18191C"/>
    <SolidColorBrush x:Key="PlayerPanelStrokeBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PlayerHoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PlayerPressedBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="PlayerTrackBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="PlayerBufferBrush" Color="#70FFFFFF"/>
    <SolidColorBrush x:Key="PlayerFillBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PlayerPillBrush" Color="#B8101114"/>
    <LinearGradientBrush x:Key="PlayerScrimBottomBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#DB000000" Offset="0"/>
        <GradientStop Color="#85000000" Offset="0.42"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayerScrimTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9E000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- 字体 -->
    <FontFamily x:Key="MiSansRegularFontFamily">ms-appx:///Assets/Fonts/MiSans-Regular.ttf#MiSans</FontFamily>
    <FontFamily x:Key="MiSansMediumFontFamily">ms-appx:///Assets/Fonts/MiSans-Medium.ttf#MiSans</FontFamily>
    <FontFamily x:Key="MiSansSemiboldFontFamily">ms-appx:///Assets/Fonts/MiSans-Semibold.ttf#MiSans</FontFamily>
    <FontFamily x:Key="MiSansBoldFontFamily">ms-appx:///Assets/Fonts/MiSans-Bold.ttf#MiSans</FontFamily>
    <FontWeight x:Key="MiSansRegularFontWeight">Normal</FontWeight>
    <FontWeight x:Key="MiSansMediumFontWeight">Medium</FontWeight>
    <FontWeight x:Key="MiSansSemiboldFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="MiSansBoldFontWeight">Bold</FontWeight>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="CaptionLineHeight">16</x:Double>
    <x:Double x:Key="BodySmallFontSize">13</x:Double>
    <x:Double x:Key="BodySmallLineHeight">18</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="BodyLineHeight">20</x:Double>
    <x:Double x:Key="BodyLargeFontSize">16</x:Double>
    <x:Double x:Key="BodyLargeLineHeight">24</x:Double>
    <x:Double x:Key="SubtitleFontSize">20</x:Double>
    <x:Double x:Key="SubtitleLineHeight">28</x:Double>
    <x:Double x:Key="TitleFontSize">30</x:Double>
    <x:Double x:Key="TitleLineHeight">38</x:Double>
    <x:Double x:Key="TitleLargeFontSize">40</x:Double>
    <x:Double x:Key="TitleLargeLineHeight">48</x:Double>
    <x:Int32 x:Key="EyebrowCharacterSpacing">160</x:Int32>

    <!-- 圆角。SoftControlCornerRadius 是按钮、输入框等的 12 圆角；WinUI 自带的 ControlCornerRadius 保持不动 -->
    <CornerRadius x:Key="CornerRadiusXS">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusS">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusM">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusL">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusPill">999</CornerRadius>
    <CornerRadius x:Key="SoftControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PosterCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="LandscapeCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ContentCornerRadius">12,12,0,0</CornerRadius>

    <!-- 控件与外壳 -->
    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="ControlHeightLarge">42</x:Double>
    <x:Double x:Key="ControlHeightSmall">30</x:Double>
    <x:Double x:Key="NavItemHeight">40</x:Double>
    <x:Double x:Key="TitleBarHeight">40</x:Double>
    <x:Double x:Key="SidebarWidth">208</x:Double>
    <x:Double x:Key="CaptionButtonWidth">46</x:Double>
    <Thickness x:Key="ContentMargin">0,12,0,0</Thickness>
    <Thickness x:Key="ContentBorderThickness">1,1,0,0</Thickness>
    <Thickness x:Key="PagePadding">40,32,40,56</Thickness>

    <!-- 卡片与布局 -->
    <x:Double x:Key="PosterWidth">150</x:Double>
    <x:Double x:Key="PosterHeight">220</x:Double>
    <x:Double x:Key="LandscapeWidth">300</x:Double>
    <x:Double x:Key="LandscapeHeight">169</x:Double>
    <x:Double x:Key="LandscapeMinWidth">240</x:Double>
    <x:Double x:Key="PersonCardWidth">132</x:Double>
    <x:Double x:Key="GridColumnSpacing">20</x:Double>
    <x:Double x:Key="GridRowSpacing">28</x:Double>
    <x:Double x:Key="RailSpacing">16</x:Double>
    <x:Double x:Key="HeroMinHeight">500</x:Double>
    <x:Double x:Key="HeroMaxHeight">600</x:Double>
    <x:Double x:Key="HeroHeightRatio">0.62</x:Double>
    <x:Double x:Key="PopupShadowBlurRadius">44</x:Double>
    <x:Double x:Key="PopupShadowOffsetY">18</x:Double>

    <!-- 动效：格式与 WinUI 的 ControlFastAnimationDuration / ControlFastOutSlowInKeySpline 相同 -->
    <x:String x:Key="MotionMicroDuration">00:00:00.080</x:String>
    <x:String x:Key="MotionFastDuration">00:00:00.160</x:String>
    <x:String x:Key="MotionNormalDuration">00:00:00.240</x:String>
    <x:String x:Key="MotionRouteDuration">00:00:00.280</x:String>
    <x:String x:Key="MotionPlayerDuration">00:00:00.360</x:String>
    <x:String x:Key="MotionHeroDuration">00:00:00.480</x:String>
    <x:String x:Key="MotionSettleDuration">00:00:00.500</x:String>
    <x:String x:Key="MotionStandardKeySpline">0.4,0,0.2,1</x:String>
    <x:String x:Key="MotionEnterKeySpline">0,0,0.2,1</x:String>
    <x:String x:Key="MotionExitKeySpline">0.4,0,1,1</x:String>
    <x:String x:Key="MotionFluidKeySpline">0.2,0.8,0.2,1</x:String>
    <x:String x:Key="MotionSettleKeySpline">0.22,1,0.36,1</x:String>
