<UserControl
    x:Class="Mambo.App.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls"
    xmlns:images="using:Mambo.App.Images"
    xmlns:vm="using:Mambo.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="DetailPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Background" Value="{ThemeResource HeroPlayBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource HeroPlayForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" CornerRadius="36" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource HeroPlayStrokeBrush}" BorderThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource AccentBrush}"/><Setter Target="PlayGlyph.Foreground" Value="{ThemeResource TextOnAccentBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource AccentPressedBrush}"/><Setter Target="PlayGlyph.Foreground" Value="{ThemeResource TextOnAccentBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.55"/></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <FontIcon x:Name="PlayGlyph" Glyph="&#xF5B0;" FontSize="24" Margin="3,0,0,0" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailReplayButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource HeroActionBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource HeroActionForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource HeroActionStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ReplayRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ReplayRoot.Background" Value="{ThemeResource HeroActionHoverBackgroundBrush}"/><Setter Target="ReplayContent.Foreground" Value="{ThemeResource HeroActionHoverForegroundBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ReplayRoot.Background" Value="{ThemeResource HeroActionPressedBackgroundBrush}"/><Setter Target="ReplayContent.Foreground" Value="{ThemeResource HeroActionHoverForegroundBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ReplayRoot.Opacity" Value="0.55"/></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ReplayContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasContent, Mode=OneWay}">
            <StackPanel Padding="0,0,0,48">
                <Grid x:Name="Hero" Height="560" Background="{ThemeResource HeroBackgroundBrush}">
                    <Grid x:Name="ArtHost" IsHitTestVisible="False"/>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,40,56" MaxWidth="600" Spacing="14">
                        <Grid HorizontalAlignment="Left" Width="360" Height="130" Margin="0,0,0,4">
                            <images:RemoteImage x:Name="LogoArt" Source="{x:Bind ViewModel.Logo, Mode=OneWay}" Priority="Hero" DecodeWidth="360" Stretch="Uniform" Visibility="{x:Bind ViewModel.HasLogo, Mode=OneWay}" ImageOpened="OnLogoOpened"/>
                            <TextBlock x:Name="Heading" Style="{StaticResource HeroTitleTextStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HeroMetaTextStyle}">
                            <Run Foreground="{ThemeResource RatingBrush}" Text="{x:Bind ViewModel.RatingStar, Mode=OneWay}"/>
                            <Run Text="{x:Bind ViewModel.Metadata, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HeroMetaTextStyle}" Text="{x:Bind ViewModel.EpisodeLine, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasEpisodeLine, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource HeroOverviewTextStyle}" Text="{x:Bind ViewModel.Overview, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                            <Grid Width="78" Height="78">
                                <Button x:Name="PlayButton" Style="{StaticResource DetailPlayButtonStyle}" Click="OnPlayClick" IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.PlayLabel, Mode=OneWay}"/>
                                <ProgressRing Width="78" Height="78" IsIndeterminate="False" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}" Foreground="{ThemeResource HeroTitleForegroundBrush}" Background="{ThemeResource HeroProgressBackgroundBrush}" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}"/>
                                <ProgressRing Width="78" Height="78" IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}" Foreground="{ThemeResource HeroTitleForegroundBrush}" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyLargeStrongTextStyle}" Foreground="{ThemeResource HeroTitleForegroundBrush}" Text="{x:Bind ViewModel.PlayLabel, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource HeroHintForegroundBrush}" Text="{x:Bind ViewModel.PlayHint, Mode=OneWay}"/>
                            </StackPanel>
                            <Button x:Name="ReplayButton" Style="{StaticResource DetailReplayButtonStyle}" Content="从头播放" Click="OnReplayClick" Visibility="{x:Bind ViewModel.CanReplay, Mode=OneWay}" AutomationProperties.Name="从头播放"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="40,16,40,0" Spacing="10" Visibility="{x:Bind ViewModel.HasRefreshError, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodySmallTextStyle}" Text="内容更新失败" Foreground="{ThemeResource WarningBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Click="OnRetryClick"/>
                </StackPanel>
                <StackPanel Margin="0,28,0,0" Spacing="10" Visibility="{x:Bind ViewModel.ShowEpisodeSection, Mode=OneWay}">
                    <Grid Margin="40,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="剧集" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource RailArrowButtonStyle}" Click="OnSeasonsLeftClick" AutomationProperties.Name="向左滚动季"><FontIcon Glyph="&#xE76B;" FontSize="10"/></Button>
                        <ScrollViewer x:Name="SeasonScroller" Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Seasons}">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:DetailSeasonViewModel"><ToggleButton Style="{StaticResource ChipStyle}" Content="{x:Bind Title}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Tag="{x:Bind Id}" Click="OnSeasonClick"/></DataTemplate></ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <Button Grid.Column="3" Style="{StaticResource RailArrowButtonStyle}" Click="OnSeasonsRightClick" AutomationProperties.Name="向右滚动季"><FontIcon Glyph="&#xE76C;" FontSize="10"/></Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="40,0" Spacing="10" Visibility="{x:Bind ViewModel.HasSeriesError, Mode=OneWay}">
                        <TextBlock Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource WarningBrush}" Text="{x:Bind ViewModel.SeriesErrorText, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Click="OnRetryClick"/>
                    </StackPanel>
                    <ProgressRing Margin="40,10" HorizontalAlignment="Left" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsSeriesLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSeriesLoading, Mode=OneWay}"/>
                    <Grid>
                        <ListView x:Name="EpisodeList" Height="240" ItemsSource="{x:Bind ViewModel.Episodes}" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource RailItemStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" Padding="40,8,24,10" Loaded="OnEpisodeListLoaded">
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetailEpisodeViewModel">
                                    <Grid Width="300" Height="218">
                                        <Button Style="{StaticResource CardButtonStyle}" Click="OnEpisodeClick" Tag="{x:Bind Id}" AutomationProperties.Name="{x:Bind Title}">
                                            <StackPanel Spacing="8">
                                                <Grid Height="169" CornerRadius="{StaticResource LandscapeCornerRadius}" Background="{ThemeResource ImagePlaceholderBrush}">
                                                    <images:RemoteImage Source="{x:Bind Image}" CornerRadius="{StaticResource LandscapeCornerRadius}" DecodeWidth="300"/>
                                                    <Border CornerRadius="{StaticResource LandscapeCornerRadius}" BorderThickness="2" BorderBrush="{ThemeResource AccentBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}"/>
                                                    <Border Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Background="#99000000" Padding="5" Visibility="{x:Bind Played}"><FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="12"/></Border>
                                                    <Grid Height="4" VerticalAlignment="Bottom" Margin="8" Background="#52FFFFFF" CornerRadius="2" Visibility="{x:Bind HasProgress}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="{x:Bind ProgressDone}"/><ColumnDefinition Width="{x:Bind ProgressRest}"/></Grid.ColumnDefinitions>
                                                        <Border Background="White" CornerRadius="2"/>
                                                    </Grid>
                                                </Grid>
                                                <StackPanel Spacing="2" Padding="2,0"><TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{x:Bind Title}"/><TextBlock Style="{StaticResource CardSubtitleTextStyle}" Text="{x:Bind Subtitle}"/></StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource CardPlayButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,123,10,0" Tag="{x:Bind Id}" Click="OnEpisodePlayClick" AutomationProperties.Name="播放这一集" ToolTipService.ToolTip="播放这一集"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Style="{StaticResource RailArrowButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,42" Click="OnEpisodesLeftClick" AutomationProperties.Name="向左滚动剧集"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
                        <Button Style="{StaticResource RailArrowButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,42" Click="OnEpisodesRightClick" AutomationProperties.Name="向右滚动剧集"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
                    </Grid>
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsEpisodesLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEpisodesLoading, Mode=OneWay}"/>
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"/>
                    <controls:StateView Glyph="&#xE783;" Title="剧集加载失败" Visibility="{x:Bind ViewModel.HasEpisodesError, Mode=OneWay}"><controls:StateView.Actions><Button Style="{StaticResource SoftAccentButtonStyle}" Content="重试" Click="OnRetryClick"/></controls:StateView.Actions></controls:StateView>
                    <Button Style="{StaticResource SoftButtonStyle}" Content="重试加载" HorizontalAlignment="Center" Click="OnLoadMoreClick" Visibility="{x:Bind ViewModel.HasEpisodeMoreError, Mode=OneWay}"/>
                    <controls:StateView Glyph="&#xE714;" Title="暂无剧集" Visibility="{x:Bind ViewModel.IsEpisodesEmpty, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Margin="0,28,0,0" Spacing="10" Visibility="{x:Bind ViewModel.HasPeople, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SubtitleTextStyle}" Text="演职人员" Margin="40,0"/>
                    <ListView ItemsSource="{x:Bind ViewModel.People}" Height="242" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource RailItemStyle}" Padding="40,8,24,10"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemTemplate><DataTemplate x:DataType="vm:DetailPersonViewModel"><StackPanel Width="132" Spacing="8"><Grid Height="176" CornerRadius="{StaticResource LandscapeCornerRadius}" Background="{ThemeResource ImagePlaceholderBrush}"><FontIcon Glyph="&#xE77B;" FontSize="48" Foreground="{ThemeResource TextTertiaryBrush}"/><images:RemoteImage Source="{x:Bind Image}" DecodeWidth="132" CornerRadius="{StaticResource LandscapeCornerRadius}"/></Grid><StackPanel Spacing="2"><TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{x:Bind Name}"/><TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Role}"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Style="{StaticResource SkeletonBlockStyle}" Height="560" VerticalAlignment="Top" CornerRadius="0" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        <controls:StateView Glyph="&#xE783;" Title="详情加载失败" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"><controls:StateView.Actions><Button Style="{StaticResource SoftAccentButtonStyle}" Content="重试" Click="OnRetryClick"/></controls:StateView.Actions></controls:StateView>
    </Grid>
</UserControl>
