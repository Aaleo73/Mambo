<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="HeroTitleForegroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="HeroMetaForegroundBrush" Color="#EBFFFFFF"/>
            <SolidColorBrush x:Key="HeroOverviewForegroundBrush" Color="#DBFFFFFF"/>
            <SolidColorBrush x:Key="HeroHintForegroundBrush" Color="#C2FFFFFF"/>
            <SolidColorBrush x:Key="HeroSeparatorBrush" Color="#8CFFFFFF"/>
            <SolidColorBrush x:Key="HeroBadgeStrokeBrush" Color="#E6FFFFFF"/>
            <SolidColorBrush x:Key="HeroPlayBackgroundBrush" Color="#76000000"/>
            <SolidColorBrush x:Key="HeroPlayForegroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="HeroPlayStrokeBrush" Color="#48FFFFFF"/>
            <SolidColorBrush x:Key="HeroProgressBackgroundBrush" Color="#40FFFFFF"/>
            <SolidColorBrush x:Key="HeroActionBackgroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="HeroActionForegroundBrush" Color="#FF16161A"/>
            <SolidColorBrush x:Key="HeroActionStrokeBrush" Color="#40FFFFFF"/>
            <SolidColorBrush x:Key="HeroActionHoverBackgroundBrush" Color="#FFF1F1F4"/>
            <SolidColorBrush x:Key="HeroActionPressedBackgroundBrush" Color="#FFE0E0E4"/>
            <SolidColorBrush x:Key="HeroActionHoverForegroundBrush" Color="#FF16161A"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="HeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HeroTitleForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="HeroMetaForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="HeroOverviewForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="HeroHintForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="HeroSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="HeroBadgeStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="HeroPlayBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="HeroPlayForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="HeroPlayStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="HeroProgressBackgroundBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
            <SolidColorBrush x:Key="HeroActionBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="HeroActionForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="HeroActionStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="HeroActionHoverBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="HeroActionPressedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="HeroActionHoverForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- 字重与字体文件必须成对设置，否则 DirectWrite 会模拟粗细 -->
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="MiSansRegularFontFamily"/>

    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansRegularFontFamily}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextLineBounds" Value="Full"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>

    <!-- 按钮内的文字：不设前景色，继承按钮在悬停、按下时的颜色 -->
    <Style x:Key="ButtonLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="TextLineBounds" Value="Full"/>
    </Style>
    <!-- 不设前景色的小号正文，用在链接等需要继承颜色的地方 -->
    <Style x:Key="InheritedSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansRegularFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="TextLineBounds" Value="Full"/>
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="LineHeight" Value="{StaticResource CaptionLineHeight}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="BodySmallTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="LineHeight" Value="{StaticResource BodySmallLineHeight}"/>
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}"/>
    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BodyLargeStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodyLargeFontSize}"/>
        <Setter Property="LineHeight" Value="{StaticResource BodyLargeLineHeight}"/>
    </Style>
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}"/>
        <Setter Property="LineHeight" Value="{StaticResource SubtitleLineHeight}"/>
    </Style>
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}"/>
        <Setter Property="LineHeight" Value="{StaticResource TitleLineHeight}"/>
        <Setter Property="CharacterSpacing" Value="-10"/>
    </Style>
    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="LineHeight" Value="{StaticResource CaptionLineHeight}"/>
        <Setter Property="CharacterSpacing" Value="{StaticResource EyebrowCharacterSpacing}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}"/>
    </Style>
    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MiSansMediumFontFamily}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="CardSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="LineHeight" Value="52"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource HeroTitleForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxLines" Value="2"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="HeroOverviewTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansMediumFontFamily}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource HeroOverviewForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxLines" Value="2"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="HeroMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansMediumFontFamily}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource HeroMetaForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HeroSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource HeroSeparatorBrush}"/>
    </Style>
    <Style x:Key="HeroRatingIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource RatingBrush}"/>
    </Style>
    <Style x:Key="HeroBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource HeroTitleForegroundBrush}"/>
    </Style>
    <Style x:Key="OnboardingTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MiSansBoldFontFamily}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="96"/>
        <Setter Property="CharacterSpacing" Value="-45"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
</ResourceDictionary>
