<UserControl
    x:Class="Mambo.App.Views.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:Mambo.App.Themes">
    <!-- 眉标和标题在左，操作和计数胶囊在右，都与标题底边对齐 -->
    <Grid Margin="0,0,0,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Bottom">
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" Text="{x:Bind Eyebrow, Mode=OneWay}"/>
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind Title, Mode=OneWay}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,2">
            <ContentPresenter VerticalAlignment="Center" Content="{x:Bind Actions, Mode=OneWay}"/>
            <Grid Width="96" Height="{StaticResource PillHeight}" Visibility="{x:Bind HasCount, Mode=OneWay}">
                <Border CornerRadius="18" themes:SoftShadow.Kind="Control"/>
                <Border CornerRadius="18" Background="{ThemeResource ControlFillBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1">
                    <TextBlock x:Name="CountLabel" Style="{StaticResource BodySmallTextStyle}" FontFamily="{StaticResource MiSansMediumFontFamily}" FontWeight="Medium"
                               Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{x:Bind Count, Mode=OneWay}"/>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
