<UserControl
    x:Class="Mambo.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls"
    xmlns:vm="using:Mambo.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:FilterChipViewModel">
            <ToggleButton Style="{StaticResource ChipStyle}" Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                          Tag="{x:Bind}" Click="OnChipClick"/>
        </DataTemplate>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodySmallTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            <Setter Property="LineHeight" Value="30"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ViewChanged="OnScrollViewChanged">
        <StackPanel Padding="{StaticResource PagePadding}">
            <controls:PageHeader Eyebrow="LIBRARY" Title="{x:Bind ViewModel.Title}" Count="{x:Bind ViewModel.CountText, Mode=OneWay}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FilterButton" Style="{StaticResource SoftButtonStyle}" Click="OnFilterClick" AutomationProperties.Name="筛选">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                                <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="筛选"/>
                                <Border MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" Background="{ThemeResource AccentBrush}"
                                        Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource BadgeTextStyle}" HorizontalAlignment="Center" Text="{x:Bind ViewModel.FilterCountText, Mode=OneWay}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SortButton" Style="{StaticResource SoftButtonStyle}" MinWidth="132" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="排序">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8CB;" FontSize="14"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource ButtonLabelTextStyle}" Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12"/>
                            </Grid>
                            <Button.Flyout>
                                <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" MenuFlyoutPresenterStyle="{StaticResource PopupMenuPresenterStyle}"/>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Border x:Name="FilterPanel" Margin="0,-6,0,24" Padding="16,14,16,12" CornerRadius="{StaticResource CornerRadiusL}"
                    Background="{ThemeResource ControlFillBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.FiltersOpen, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="类型"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.GenreChips}" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:WrapPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="年份"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.DecadeChips}" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:WrapPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="分级"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.RatingChips}" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:WrapPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right" Content="重置筛选" Click="OnResetClick"
                            Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <ItemsRepeater x:Name="Grid" ItemsSource="{x:Bind ViewModel.Cards.Items, Mode=OneWay}" ElementPrepared="OnElementPrepared"
                           XYFocusKeyboardNavigation="Enabled" SizeChanged="OnGridSizeChanged">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="{StaticResource PosterWidth}" MinColumnSpacing="{StaticResource GridColumnSpacing}"
                                       MinRowSpacing="{StaticResource GridRowSpacing}" ItemsJustification="SpaceBetween" ItemsStretch="None"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaCardViewModel">
                        <controls:PosterCard Item="{x:Bind}"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <controls:WrapPanel x:Name="Skeleton" Spacing="20" Visibility="{x:Bind ViewModel.Cards.IsLoadingFirst, Mode=OneWay}"/>
            <ProgressRing Margin="0,28,0,8" Width="20" Height="20" IsActive="{x:Bind ViewModel.Cards.IsLoadingMore, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.Cards.IsLoadingMore, Mode=OneWay}"/>
            <Button Style="{StaticResource SoftButtonStyle}" Margin="0,28,0,8" HorizontalAlignment="Center" Content="重试加载" Click="OnLoadMoreClick"
                    Visibility="{x:Bind ViewModel.Cards.HasMoreError, Mode=OneWay}"/>

            <controls:StateView Glyph="&#xE71C;" Title="当前筛选没有内容" Visibility="{x:Bind ViewModel.ShowFilteredEmpty, Mode=OneWay}">
                <controls:StateView.Actions>
                    <Button Style="{StaticResource SoftAccentButtonStyle}" Content="重置筛选" Click="OnResetClick"/>
                </controls:StateView.Actions>
            </controls:StateView>
            <controls:StateView Glyph="&#xE8B7;" Title="暂无内容" Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}"/>
            <controls:StateView Glyph="&#xE783;" Title="资料库加载失败" Visibility="{x:Bind ViewModel.Cards.HasError, Mode=OneWay}">
                <controls:StateView.Actions>
                    <Button Style="{StaticResource SoftAccentButtonStyle}" Content="重试" Click="OnRetryClick"/>
                </controls:StateView.Actions>
            </controls:StateView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
