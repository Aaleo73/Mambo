<UserControl
    x:Class="Mambo.App.Shell.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Mambo.App.Shell"
    xmlns:themes="using:Mambo.App.Themes"
    KeyboardAcceleratorPlacementMode="Hidden">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="ShellCloseCaptionStyle" ResourceKey="CloseCaptionButtonStyle"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Style x:Key="ShellCloseCaptionStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleBarHeightGridLength}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SidebarGridLength}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="BackdropFallback" Grid.RowSpan="2" Grid.ColumnSpan="2"
                Background="{ThemeResource WindowOpaqueFallbackBrush}" IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw"/>
        <!-- 玻璃面板：亚克力之上的白色渐变、1px 细边和顶部内高光 -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{ThemeResource GlassWashBrush}"
                BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1" IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw"/>
        <Border Grid.ColumnSpan="2" Height="1" Margin="1,1,1,0" VerticalAlignment="Top" Background="{ThemeResource GlassHighlightBrush}"
                IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
        <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SidebarGridLength}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="NavButtons" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource TitleBarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        Click="OnBackClick" ToolTipService.ToolTip="后退（Alt+←）" AutomationProperties.Name="后退">
                    <themes:LineIcon Glyph="{StaticResource IconChevronLeft}" Width="16" Height="16" StrokeWidth="2.2"/>
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource TitleBarButtonStyle}" IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                        Click="OnForwardClick" ToolTipService.ToolTip="前进（Alt+→）" AutomationProperties.Name="前进">
                    <themes:LineIcon Glyph="{StaticResource IconChevronRight}" Width="16" Height="16" StrokeWidth="2.2"/>
                </Button>
            </StackPanel>
            <!-- 标题和首页分页点都居中在侧栏右侧的整段区域里；两侧各留 140，避开窗口按钮 -->
            <Grid x:Name="CenterArea" Grid.Column="1" Grid.ColumnSpan="2" Padding="140,0">
                <TextBlock x:Name="TitleLabel" Style="{StaticResource BodyStrongTextStyle}" CharacterSpacing="-10"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"/>
                <ContentPresenter x:Name="CenterContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMinimizeClick" IsTabStop="True" UseSystemFocusVisuals="True"
                        ToolTipService.ToolTip="最小化" AutomationProperties.Name="最小化">
                    <themes:LineIcon Glyph="{StaticResource CaptionMinimize}" Box="10" StrokeWidth="1" Width="10" Height="10"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMaximizeClick" IsTabStop="True" UseSystemFocusVisuals="True"
                        ToolTipService.ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" Padding="0">
                  <Grid Width="{StaticResource CaptionButtonWidth}" Height="{StaticResource TitleBarHeight}">
                    <Border x:Name="MaximizeHover" Background="{ThemeResource WashBrush}" Opacity="0"/>
                    <Border x:Name="MaximizePressed" Background="{ThemeResource WashPressedBrush}" Opacity="0"/>
                    <!-- 最大化按钮登记为非客户区，收不到指针状态；用透明度在次要色与主要色之间切换 -->
                    <themes:LineIcon x:Name="MaximizeGlyph" Glyph="{StaticResource CaptionMaximize}" Box="10" StrokeWidth="1" Width="10" Height="10"
                                     Foreground="{ThemeResource TextPrimaryBrush}" Opacity="0.8" HorizontalAlignment="Center"/>
                  </Grid>
                </Button>
                <Button x:Name="CloseButton" Style="{ThemeResource ShellCloseCaptionStyle}" Click="OnCloseClick" IsTabStop="True" UseSystemFocusVisuals="True"
                        ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭">
                    <themes:LineIcon Glyph="{StaticResource CaptionClose}" Box="10" StrokeWidth="1.2" Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="BrowseFace" Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SidebarGridLength}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarSlot"/>
            <Border x:Name="Well" Grid.Column="1" Margin="{StaticResource ContentMargin}"
                    BorderBrush="{ThemeResource ContentStrokeBrush}" BorderThickness="{StaticResource ContentBorderThickness}"
                    CornerRadius="{StaticResource ContentCornerRadius}">
                <Grid x:Name="WellContent">
                    <shell:HeroBackdropPresenter x:Name="HeroBackdrop" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                    <shell:PageHost x:Name="Pages"/>
                </Grid>
            </Border>
            <Border x:Name="BrowseShade" Grid.ColumnSpan="2" Background="Black" Opacity="0"
                    IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>

        <Grid x:Name="PlayerSlot" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Grid x:Name="PlayerContent"/>
            <Border x:Name="PlayerShade" Background="Black" Opacity="0" IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
        <Grid x:Name="OverlayLayer" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <shell:DialogHost x:Name="Dialogs" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
    </Grid>
</UserControl>
