<UserControl
    x:Class="Mambo.App.Views.PlayerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:video="using:Mambo.App.Video"
    xmlns:vm="using:Mambo.App.ViewModels"
    xmlns:images="using:Mambo.App.Images"
    AutomationProperties.Name="播放器" RequestedTheme="Dark" IsTabStop="True" UseSystemFocusVisuals="False" TabFocusNavigation="Cycle">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#80FFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFFFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#80FFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#4DFFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF"/>
                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#1AFFFFFF"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorButtonTextColor}"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
                <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}"/>
                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
                <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource SystemColorGrayTextColor}"/>
                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{ThemeResource SystemColorWindowTextColor}"/>
                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{ThemeResource SystemColorGrayTextColor}"/>
                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource PlayerButtonForegroundBrush}"/>
            <Setter Property="Background" Value="{ThemeResource PlayerButtonBackgroundBrush}"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="AllowFocusOnInteraction" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ButtonRoot.Background" Value="{ThemeResource PlayerHoverBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ButtonRoot.Background" Value="{ThemeResource PlayerPressedBrush}"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ButtonContent.Foreground" Value="{ThemeResource TextDisabledBrush}"/></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ButtonContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerMenuPresenter" TargetType="MenuFlyoutPresenter">
            <Setter Property="RequestedTheme" Value="Dark"/>
            <Setter Property="Background" Value="{ThemeResource PlayerPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource PlayerPanelStrokeBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MaxHeight" Value="340"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <DataTemplate x:Key="BufferedRangeTemplate"><Border Height="4" CornerRadius="2" Background="{ThemeResource PlayerBufferBrush}"/></DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="{ThemeResource PlayerCanvasBrush}">
        <Grid x:Name="VideoHost" Background="{ThemeResource PlayerCanvasBrush}"><video:VideoSurface x:Name="Surface"/></Grid>
        <Grid x:Name="InputSurface" Background="Transparent" Tapped="OnSurfaceTapped" DoubleTapped="OnSurfaceDoubleTapped"
              PointerMoved="OnSurfacePointerMoved" PointerEntered="OnSurfacePointerEntered" PointerExited="OnSurfacePointerExited"
              PointerPressed="OnSurfacePointerPressed" PointerReleased="OnSurfacePointerReleased" PointerCanceled="OnSurfacePointerReleased"/>

        <StackPanel x:Name="ExternalPanel" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                    Visibility="{x:Bind ViewModel.ShowExternalPanel, Mode=OneWay}">
            <FontIcon Glyph="&#xE8A7;" FontSize="44" Foreground="{ThemeResource PlayerTextSecondaryBrush}"/>
            <TextBlock Text="正在外部播放" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource PlayerTextPrimaryBrush}" HorizontalAlignment="Center"/>
            <Button x:Name="ExternalStopButton" Content="停止播放" HorizontalAlignment="Center" Style="{ThemeResource PlayerButton}" Click="OnCloseClick"/>
        </StackPanel>

        <Grid x:Name="Chrome" IsHitTestVisible="False" Opacity="0">
            <Grid x:Name="TopBar" VerticalAlignment="Top" Background="{ThemeResource PlayerScrimTopBrush}" Padding="24,18,24,48">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="FullscreenTitles" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PlayerTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource PlayerTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Style="{ThemeResource PlayerButton}" Click="OnCloseClick" AutomationProperties.Name="关闭播放" ToolTipService.ToolTip="关闭播放（Esc）">
                    <FontIcon Glyph="&#xE8BB;" FontSize="18"/>
                </Button>
            </Grid>
            <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Background="{ThemeResource PlayerScrimBottomBrush}" Padding="24,72,24,18">
                <StackPanel Spacing="8">
                    <Grid x:Name="SeekHost" Height="32" SizeChanged="OnSeekHostSizeChanged">
                        <Canvas x:Name="BufferedCanvas" Height="4" Margin="0,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}" ValueChanged="OnSeekValueChanged" AllowFocusOnInteraction="False"
                                AutomationProperties.Name="播放进度" ThumbToolTipValueConverter="{x:Null}"/>
                        <Border x:Name="SeekTip" Background="{ThemeResource PlayerPanelBrush}" BorderBrush="{ThemeResource PlayerPanelStrokeBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,-28,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="SeekTipText" FontSize="12" Foreground="{ThemeResource PlayerTextPrimaryBrush}"/>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="PreviousButton" Style="{ThemeResource PlayerButton}" Click="OnPreviousClick" IsEnabled="{x:Bind ViewModel.CanPrevious, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasEpisodes, Mode=OneWay}" AutomationProperties.Name="上一集" ToolTipService.ToolTip="上一集"><FontIcon Glyph="&#xE892;" FontSize="18"/></Button>
                            <Button x:Name="PauseButton" Width="44" Height="44" CornerRadius="22" Padding="0" Background="{ThemeResource PlayerPlayBackgroundBrush}" Foreground="{ThemeResource PlayerPlayForegroundBrush}" AllowFocusOnInteraction="False"
                                    Click="OnPauseClick" IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.PauseAccessibleName, Mode=OneWay}" ToolTipService.ToolTip="播放 / 暂停（空格）">
                                <FontIcon Glyph="{x:Bind ViewModel.PauseGlyph, Mode=OneWay}" FontSize="20"/>
                            </Button>
                            <Button x:Name="NextButton" Style="{ThemeResource PlayerButton}" Click="OnNextClick" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasEpisodes, Mode=OneWay}" AutomationProperties.Name="下一集" ToolTipService.ToolTip="下一集"><FontIcon Glyph="&#xE893;" FontSize="18"/></Button>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" Foreground="{ThemeResource PlayerTextPrimaryBrush}" FontSize="13"/>
                                <TextBlock Text="/" Foreground="{ThemeResource PlayerTextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" Foreground="{ThemeResource PlayerTextSecondaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="RateButton" Style="{ThemeResource PlayerButton}" Content="{x:Bind ViewModel.RateText, Mode=OneWay}" Click="OnRateClick"
                                    IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}" AutomationProperties.Name="播放速度" ToolTipService.ToolTip="倍速（[ / ]）"/>
                            <Button x:Name="TracksButton" Style="{ThemeResource PlayerButton}" Click="OnTracksClick" IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}"
                                    AutomationProperties.Name="字幕和音轨" ToolTipService.ToolTip="字幕 / 音轨（C / V）"><FontIcon Glyph="&#xE7F0;" FontSize="18"/></Button>
                            <StackPanel x:Name="VolumeHost" Orientation="Horizontal" PointerEntered="OnVolumeEntered" PointerExited="OnVolumeExited" GotFocus="OnVolumeGotFocus" LostFocus="OnVolumeLostFocus">
                                <Button x:Name="MuteButton" Style="{ThemeResource PlayerButton}" Click="OnMuteClick" IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ViewModel.MuteAccessibleName, Mode=OneWay}" ToolTipService.ToolTip="静音（M）"><FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="18"/></Button>
                                <Slider x:Name="VolumeSlider" Width="84" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Visibility="Collapsed" AllowFocusOnInteraction="False"
                                        ValueChanged="OnVolumeChanged" IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}" AutomationProperties.Name="音量"/>
                            </StackPanel>
                            <Button x:Name="EpisodesButton" Style="{ThemeResource PlayerButton}" Click="OnEpisodesClick" Visibility="{x:Bind ViewModel.HasEpisodes, Mode=OneWay}"
                                    AutomationProperties.Name="选集" ToolTipService.ToolTip="选集"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="16"/><TextBlock Text="选集"/></StackPanel></Button>
                            <Button x:Name="FullscreenButton" Style="{ThemeResource PlayerButton}" Click="OnFullscreenClick" AutomationProperties.Name="切换全屏" ToolTipService.ToolTip="全屏（F11）"><FontIcon x:Name="FullscreenGlyph" Glyph="&#xE740;" FontSize="18"/></Button>
                            <Button x:Name="MaximizeButton" Style="{ThemeResource PlayerButton}" Click="OnMaximizeClick" AutomationProperties.Name="最大化或还原" ToolTipService.ToolTip="最大化 / 还原"><FontIcon x:Name="MaximizeGlyph" Glyph="&#xE922;" FontSize="16"/></Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="StateLayer">
            <StackPanel x:Name="OpeningPanel" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsOpening, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsOpening, Mode=OneWay}" Width="44" Height="44" Foreground="{ThemeResource PlayerTextPrimaryBrush}"/>
                <TextBlock Text="正在打开" Foreground="{ThemeResource PlayerTextPrimaryBrush}" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SlowOpeningHint" Text="片源响应较慢" Foreground="{ThemeResource PlayerTextSecondaryBrush}" Visibility="{x:Bind ViewModel.IsSlowOpening, Mode=OneWay}"/>
                <Button x:Name="SlowOpeningCloseButton" Content="关闭播放页" Style="{ThemeResource PlayerButton}" Click="OnCloseClick" HorizontalAlignment="Center" IsHitTestVisible="True" Visibility="{x:Bind ViewModel.IsSlowOpening, Mode=OneWay}"/>
            </StackPanel>
            <Border x:Name="BufferingPill" Background="{ThemeResource PlayerPillBrush}" CornerRadius="18" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsBuffering, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBuffering, Mode=OneWay}"/><TextBlock Text="缓冲中…" Foreground="{ThemeResource PlayerTextPrimaryBrush}"/></StackPanel>
            </Border>
            <Button x:Name="BigPlay" Width="80" Height="80" CornerRadius="40" Background="{ThemeResource PlayerBigPlayBackgroundBrush}" BorderBrush="{ThemeResource PlayerBigPlayStrokeBrush}" BorderThickness="1"
                    AllowFocusOnInteraction="False" Foreground="{ThemeResource PlayerTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnPauseClick"
                    Visibility="Collapsed" IsHitTestVisible="True" AutomationProperties.Name="继续播放"><FontIcon Glyph="&#xE768;" FontSize="32" Foreground="{ThemeResource PlayerTextPrimaryBrush}"/></Button>
            <Border x:Name="ErrorPanel" Width="380" Padding="26" Background="{ThemeResource PlayerPanelBrush}" BorderBrush="{ThemeResource PlayerPanelStrokeBrush}"
                    BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
                <StackPanel Spacing="14" IsHitTestVisible="True">
                    <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="{ThemeResource DangerBrush}"/>
                    <TextBlock Text="这部片子暂时打不开" Foreground="{ThemeResource PlayerTextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource PlayerTextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="RetryButton" Style="{ThemeResource PlayerButton}" Content="从断点重试" Click="OnRetryClick"/>
                        <Button x:Name="ErrorCloseButton" Style="{ThemeResource PlayerButton}" Content="关闭" Click="OnCloseClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="UpNext" Width="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,112" Padding="16"
                CornerRadius="12" Background="{ThemeResource PlayerPanelBrush}" BorderBrush="{ThemeResource PlayerPanelStrokeBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock Text="即将播放" Foreground="{ThemeResource PlayerTextSecondaryBrush}" FontSize="12"/>
                <TextBlock Text="{x:Bind ViewModel.NextTitle, Mode=OneWay}" Foreground="{ThemeResource PlayerTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="UpNextPlayButton" Content="立即播放" Style="{ThemeResource PlayerButton}" Click="OnNextClick"/><Button x:Name="UpNextCancelButton" Content="取消" Style="{ThemeResource PlayerButton}" Click="OnDismissUpNextClick"/><TextBlock Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" Foreground="{ThemeResource PlayerTextSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="EpisodeDrawer" Width="360" HorizontalAlignment="Right" Background="{ThemeResource PlayerDrawerBrush}" Visibility="Collapsed" TabFocusNavigation="Cycle">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Padding="20,18,14,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="选集" Foreground="{ThemeResource PlayerTextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="EpisodeListButton" Grid.Column="1" Style="{ThemeResource PlayerButton}" Click="OnEpisodeListClick" ToolTipService.ToolTip="列表" AutomationProperties.Name="选集列表"><FontIcon Glyph="&#xE8FD;" FontSize="16"/></Button>
                <Button x:Name="EpisodeGridButton" Grid.Column="2" Style="{ThemeResource PlayerButton}" Click="OnEpisodeGridClick" ToolTipService.ToolTip="集号" AutomationProperties.Name="选集网格"><FontIcon Glyph="&#xE80A;" FontSize="16"/></Button>
                <Button x:Name="EpisodeCloseButton" Grid.Column="3" Style="{ThemeResource PlayerButton}" Click="OnEpisodesClick" ToolTipService.ToolTip="关闭选集" AutomationProperties.Name="关闭选集"><FontIcon Glyph="&#xE8BB;" FontSize="16"/></Button>
            </Grid>
            <ScrollViewer x:Name="EpisodeListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="EpisodeList" ItemsSource="{x:Bind ViewModel.Episodes}" Margin="10,0,10,16">
                    <ItemsRepeater.Layout><StackLayout Spacing="2"/></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:PlayerEpisodeViewModel">
                        <Button Style="{ThemeResource PlayerButton}" Height="80" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Tag="{x:Bind ItemId}" Click="OnEpisodeClick" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Height="63" CornerRadius="6" Background="{ThemeResource PlayerImagePlaceholderBrush}"><images:RemoteImage Source="{x:Bind Image}" DecodeWidth="112" CornerRadius="6"/><Border Visibility="{x:Bind IsCurrent, Mode=OneWay}" Background="{ThemeResource PlayerImageScrimBrush}" CornerRadius="6"><FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource PlayerTextPrimaryBrush}"/></Border></Grid>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{x:Bind Number}" FontSize="12" Style="{ThemeResource PlayerEpisodeSecondaryTextStyle}"/><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock Text="{x:Bind Description}" Style="{ThemeResource PlayerEpisodeDescriptionTextStyle}" FontSize="12"/></StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <ScrollViewer x:Name="EpisodeGridScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="EpisodeGrid" ItemsSource="{x:Bind ViewModel.Episodes}" Margin="20,0,20,20">
                    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="56" MinItemHeight="56" MaximumRowsOrColumns="5" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill"/></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:PlayerEpisodeViewModel">
                        <Button Style="{ThemeResource PlayerButton}" Height="56" Background="{ThemeResource PlayerEpisodeGridBrush}" Tag="{x:Bind ItemId}" Click="OnEpisodeClick" ToolTipService.ToolTip="{x:Bind Title}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                            <Grid><Border Visibility="{x:Bind IsCurrent, Mode=OneWay}" Background="{ThemeResource PlayerEpisodeCurrentBrush}" CornerRadius="6"/><TextBlock Text="{x:Bind Number}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Button>
                    </DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
