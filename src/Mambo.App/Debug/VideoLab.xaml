<UserControl
    x:Class="Mambo.App.Debug.VideoLab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:video="using:Mambo.App.Video">
    <Grid Background="#171717" RequestedTheme="Dark" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="Video Lab · 视频与会话验证" FontSize="22" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="AddressBox" PlaceholderText="本地文件路径或 HTTP/HTTPS 播放地址（仅保留在内存）" />
                <Button Grid.Column="1" Content="选择本地文件" Click="PickFileClicked" />
                <Button x:Name="OpenButton" Grid.Column="2" Content="打开" Click="OpenClicked" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox x:Name="ServerBox" PlaceholderText="Emby 服务器地址（可选，仅内存）" />
                <PasswordBox x:Name="TokenBox" Grid.Column="1" PlaceholderText="令牌（可选，仅内存，跨域跳转不携带）" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="恢复 Emby 会话" Click="RestoreBackendClicked" />
                <TextBox x:Name="ItemIdBox" Width="280" PlaceholderText="itemId（仅内存）" />
                <Button Content="按 itemId 播放" Click="PlayItemClicked" />
                <Button Content="上一集" Click="PreviousItemClicked" />
                <Button Content="下一集" Click="NextItemClicked" />
                <Button Content="1.5 倍速" Click="RateItemClicked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="选择并批准外部 MPV" Click="PickExternalMpvClicked" />
                <Button Content="使用内置播放" Click="UseEmbeddedClicked" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <Grid x:Name="VideoHost" Background="Black">
                <video:VideoSurface x:Name="Surface" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Content="画面上方的 XAML 按钮 · 点击暂停" Click="PauseClicked" />
            </Grid>
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="诊断" FontSize="18" />
                    <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                    <TextBlock Text="人工检查：HDR 高光、100/150/200% DPI、跨显示器拖动、全屏顶部缝隙、按钮点击与光标隐藏。" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" ManipulationMode="None" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="播放 / 暂停" Click="PauseClicked" />
                <Button Content="停止并销毁" Click="StopClicked" />
                <ComboBox x:Name="HdrBox" SelectedIndex="0" SelectionChanged="HdrChanged" Width="130">
                    <ComboBoxItem Content="HDR 自动" /><ComboBoxItem Content="始终 HDR" /><ComboBoxItem Content="HDR 关闭" />
                </ComboBox>
                <Button Content="全屏 / 退出全屏" Click="FullscreenClicked" />
                <Button Content="最大化 / 还原" Click="MaximizeClicked" />
                <ToggleSwitch Header="隐藏画面光标" Toggled="CursorChanged" />
                <Button Content="创建 / 销毁 20 次" Click="StressClicked" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="就绪。选择本地文件开始验证。" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
