<UserControl
    x:Class="Mambo.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls"
    xmlns:vm="using:Mambo.App.ViewModels">
    <Grid>
        <!-- 未登录：整页就是一句大字，点它去设置。上下留白按 1 : 1.5 分 -->
        <Grid x:Name="Onboarding" Padding="40,0" Visibility="Collapsed" SizeChanged="OnOnboardingSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <Button x:Name="OnboardingButton" Grid.Row="1" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                    FocusVisualMargin="-8" Click="OnOpenSettingsClick" AutomationProperties.Name="前往连接你的 Emby 服务器">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
                <controls:OnboardingTitle x:Name="OnboardingTitle"/>
            </Button>
        </Grid>
        <controls:StateView x:Name="Unreachable" Title="无法连接服务器" Visibility="Collapsed">
            <controls:StateView.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Click="OnRetryClick"/>
                    <Button Style="{StaticResource SoftButtonStyle}" Content="打开设置" Click="OnOpenSettingsClick"/>
                </StackPanel>
            </controls:StateView.Actions>
        </controls:StateView>
        <!-- 首页的滚动条不显示，和原版一样 -->
        <ScrollViewer x:Name="Scroller" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" ViewChanged="OnScrollViewChanged">
            <Grid>
                <StackPanel x:Name="ContentPanel" Padding="0,0,0,32">
                    <controls:HeroCarousel x:Name="Hero" Height="560"/>
                    <!-- hero 文字离底边只有 12，第一行标题再往下让 20，不和简介挤在一起 -->
                    <ItemsRepeater x:Name="RailList" Margin="0,20,0,0">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RailViewModel">
                                <controls:CardRail Rail="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <StackPanel x:Name="SkeletonPanel" Visibility="Collapsed">
                    <Grid x:Name="HeroSkeleton" Height="560">
                        <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,12">
                            <Border Style="{StaticResource SkeletonBlockStyle}" Width="256" Height="40" CornerRadius="20" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Width="384" Height="16" CornerRadius="8" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlockStyle}" Width="320" Height="16" CornerRadius="8" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SkeletonBlockStyle}" Width="128" Height="24" CornerRadius="12" Margin="24,20,0,12" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="SkeletonCards" Orientation="Horizontal" Spacing="{StaticResource RailSpacing}" Padding="24,0"/>
                </StackPanel>
                <controls:StateView x:Name="LoadFailed" Title="首页加载失败" Visibility="Collapsed">
                    <controls:StateView.Actions>
                        <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Click="OnReloadClick"/>
                    </controls:StateView.Actions>
                </controls:StateView>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
