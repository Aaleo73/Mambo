<UserControl
    x:Class="Mambo.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls"
    xmlns:vm="using:Mambo.App.ViewModels">
    <Grid>
        <Grid x:Name="Onboarding" Padding="64,0,64,40" Visibility="Collapsed" SizeChanged="OnOnboardingSizeChanged">
            <Button x:Name="OnboardingButton" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                    Click="OnOpenSettingsClick" AutomationProperties.Name="前往连接你的 Emby 服务器">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock x:Name="OnboardingLine1" Style="{StaticResource OnboardingTitleStyle}" Text="前往连接你的"/>
                    <TextBlock x:Name="OnboardingLine2" Style="{StaticResource OnboardingTitleStyle}">
                        <Run Text="Emby" Foreground="{ThemeResource AccentBrush}"/><Run Text=" 服务器"/>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <controls:StateView x:Name="Unreachable" Glyph="&#xE774;" Title="无法连接服务器" Visibility="Collapsed">
            <controls:StateView.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SoftAccentButtonStyle}" Click="OnRetryClick" AutomationProperties.Name="重试">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="重试"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SoftButtonStyle}" Content="打开设置" Click="OnOpenSettingsClick"/>
                </StackPanel>
            </controls:StateView.Actions>
        </controls:StateView>
        <ScrollViewer x:Name="Scroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" ViewChanged="OnScrollViewChanged">
            <Grid>
                <StackPanel x:Name="ContentPanel" Padding="0,0,0,48">
                    <controls:HeroCarousel x:Name="Hero" Height="560"/>
                    <ItemsRepeater x:Name="RailList" Margin="0,-36,0,0">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RailViewModel">
                                <controls:CardRail Rail="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <StackPanel x:Name="SkeletonPanel" Visibility="Collapsed">
                    <Border x:Name="HeroSkeleton" Style="{StaticResource SkeletonBlockStyle}" CornerRadius="0" Height="560"/>
                    <Border Style="{StaticResource SkeletonBlockStyle}" Width="160" Height="20" Margin="40,26,0,16" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="SkeletonCards" Orientation="Horizontal" Spacing="16" Padding="40,0"/>
                </StackPanel>
                <controls:StateView x:Name="LoadFailed" Glyph="&#xE783;" Title="首页加载失败" Visibility="Collapsed">
                    <controls:StateView.Actions>
                        <Button Style="{StaticResource SoftAccentButtonStyle}" Click="OnReloadClick" AutomationProperties.Name="重试">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="重试"/>
                            </StackPanel>
                        </Button>
                    </controls:StateView.Actions>
                </controls:StateView>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
