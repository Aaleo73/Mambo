<UserControl
    x:Class="Mambo.App.Views.ErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="页面错误">
    <!-- 只有文字和两个普通按钮，没有图标 -->
    <StackPanel MaxWidth="448" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,48">
        <TextBlock Style="{StaticResource GroupTitleTextStyle}" Text="出了点问题" TextAlignment="Center"/>
        <TextBlock Style="{StaticResource BodyTextStyle}" LineHeight="24" Margin="0,4,0,0" Text="页面暂时无法显示，请重试或返回首页。" TextWrapping="Wrap" TextTrimming="None"
                   TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="HomeButton" Style="{StaticResource SoftButtonStyle}" Content="返回首页" AutomationProperties.Name="返回首页" Click="OnHomeClick"/>
            <Button x:Name="RetryButton" Style="{StaticResource SoftButtonStyle}" Content="重试" AutomationProperties.Name="重试页面" Click="OnRetryClick"/>
        </StackPanel>
    </StackPanel>
</UserControl>
