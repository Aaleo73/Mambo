<UserControl
    x:Class="Mambo.App.Views.Controls.HeroCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls">
    <Button x:Name="Root" Style="{StaticResource CardButtonStyle}" Click="OnClick"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" GotFocus="OnFocusChanged" LostFocus="OnFocusChanged">
        <Grid x:Name="Stage" Background="{ThemeResource HeroBackgroundBrush}">
            <Grid x:Name="InfoHost">
                <controls:HeroInfoPanel x:Name="FirstInfo"/>
                <controls:HeroInfoPanel x:Name="SecondInfo"/>
            </Grid>
        </Grid>
    </Button>
</UserControl>
