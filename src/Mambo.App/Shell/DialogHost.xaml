<UserControl
    x:Class="Mambo.App.Shell.DialogHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:Mambo.App.Themes"
    IsTabStop="True" TabFocusNavigation="Cycle" KeyDown="OnPanelKeyDown" Visibility="Collapsed">
    <Grid x:Name="ModalRoot" Background="Transparent" Tapped="OnScrimTapped">
        <Border x:Name="Scrim" Background="{ThemeResource ScrimBrush}" IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw"/>
        <!-- 弹出面：半透明浅底、白色描边、圆角 18、柔和投影；按钮靠右，取消在前 -->
        <Grid x:Name="Panel" Width="384" HorizontalAlignment="Center" VerticalAlignment="Center" TabFocusNavigation="Cycle"
              Tapped="OnPanelTapped">
            <Border CornerRadius="{StaticResource PopupCornerRadius}" themes:SoftShadow.Kind="Popup"/>
            <Border Style="{StaticResource PopupSurfaceStyle}" Padding="20,16">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource BodyLargeStrongTextStyle}" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock x:Name="BodyText" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,6,0,0"
                               LineHeight="24" TextWrapping="Wrap" TextTrimming="None"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                        <Button x:Name="CancelButton" Style="{StaticResource SoftButtonStyle}" MinWidth="88" Click="OnCancelClick"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource SoftAccentButtonStyle}" MinWidth="88" Click="OnConfirmClick"/>
                        <Button x:Name="DangerButton" Style="{StaticResource DangerSoftButtonStyle}" MinWidth="88" Click="OnConfirmClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
