<UserControl
    x:Class="Mambo.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls"
    xmlns:vm="using:Mambo.App.ViewModels">
    <!-- 搜索页整页滚动，滚动条不显示 -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden">
        <StackPanel Padding="{StaticResource PagePadding}">
            <controls:PageHeader Eyebrow="SEARCH" Title="搜索"/>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="24"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchGroupViewModel">
                        <StackPanel Visibility="{x:Bind IsVisible, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,12" Text="{x:Bind Name}"/>
                            <ItemsRepeater ItemsSource="{x:Bind Cards.Items}" XYFocusKeyboardNavigation="Enabled">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="{StaticResource LandscapeMinWidth}" MinColumnSpacing="{StaticResource RailSpacing}"
                                                       MinRowSpacing="{StaticResource GridRowSpacing}" ItemsStretch="Fill"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MediaCardViewModel">
                                        <controls:LandscapeCard Item="{x:Bind}" IsAdaptive="True" ShowPlayButton="False"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind Cards.HasError, Mode=OneWay}">
                                <TextBlock Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           Text="{x:Bind Cards.ErrorText, Mode=OneWay}"/>
                                <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Tag="{x:Bind}" Click="OnGroupRetryClick"/>
                            </StackPanel>
                            <Button Style="{StaticResource SoftButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Center" Content="加载更多"
                                    Tag="{x:Bind}" Click="OnLoadMoreClick" Visibility="{x:Bind CanLoadMore, Mode=OneWay}"/>
                            <Button Style="{StaticResource SoftButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Center" Content="重试加载"
                                    Tag="{x:Bind}" Click="OnLoadMoreClick" Visibility="{x:Bind Cards.HasMoreError, Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,16,0,0" HorizontalAlignment="Center" Text="正在加载"
                                       Visibility="{x:Bind Cards.IsLoadingMore, Mode=OneWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <!-- 首次搜索：两组骨架 -->
            <StackPanel x:Name="Skeleton" Spacing="24" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
            <controls:StateView Title="{x:Bind ViewModel.NoResultsTitle}" Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}"/>
            <controls:StateView Title="搜索失败" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <controls:StateView.Actions>
                    <Button Style="{StaticResource SoftButtonStyle}" Content="重试" Click="OnRetryClick"/>
                </controls:StateView.Actions>
            </controls:StateView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
