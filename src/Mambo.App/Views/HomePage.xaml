<UserControl
    x:Class="Mambo.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls">
    <Grid>
        <Grid x:Name="Onboarding" Padding="64,0,64,40" Visibility="Collapsed" SizeChanged="OnOnboardingSizeChanged">
            <Button x:Name="OnboardingButton" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                    Click="OnOpenSettingsClick" AutomationProperties.Name="前往连接你的 Emby 服务器">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock x:Name="OnboardingLine1" Style="{StaticResource OnboardingTitleStyle}" Text="前往连接你的"/>
                    <TextBlock x:Name="OnboardingLine2" Style="{StaticResource OnboardingTitleStyle}">
                        <Run Text="Emby" Foreground="{ThemeResource AccentBrush}"/><Run Text=" 服务器"/>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <controls:StateView x:Name="Unreachable" Glyph="&#xE774;" Title="无法连接服务器" Visibility="Collapsed">
            <controls:StateView.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SoftAccentButtonStyle}" Click="OnRetryClick" AutomationProperties.Name="重试">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="重试"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SoftButtonStyle}" Content="打开设置" Click="OnOpenSettingsClick"/>
                </StackPanel>
            </controls:StateView.Actions>
        </controls:StateView>
        <ScrollViewer x:Name="Scroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel"/>
        </ScrollViewer>
    </Grid>
</UserControl>
