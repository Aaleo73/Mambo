<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <Thickness x:Key="TextControlThemePadding">12,7,12,7</Thickness>

    <Style x:Key="SoftButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource SoftControlCornerRadius}"/>
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SoftAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource SoftControlCornerRadius}"/>
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SoftSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource SoftControlCornerRadius}"/>
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SoftInputStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SoftControlCornerRadius}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SoftPasswordStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SoftControlCornerRadius}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 危险操作：红色文字的柔和按钮 -->
    <Style x:Key="DangerSoftButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource DangerBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource SoftControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource DangerSubtleBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource DangerSubtleBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏按钮：后退 / 前进 -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CornerRadiusS}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource NavHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SubtleFillPressedBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Content.Opacity" Value="0.32"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 窗口按钮：46×40；关闭按钮悬停为红色 -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource CaptionButtonWidth}"/>
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SubtleFillHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SubtleFillPressedBrush}"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FFC42B1C"/>
                                        <Setter Target="Content.Foreground" Value="#FFFFFFFF"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FFC94D40"/>
                                        <Setter Target="Content.Foreground" Value="#CCFFFFFF"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏导航项：40px、半粗体，选中时左侧 3×16 主色条 -->
    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="{StaticResource NavItemHeight}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ItemCornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource NavHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource NavPressedBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.42"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ActiveFill.Opacity" Value="1"/>
                                        <Setter Target="Pill.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ActiveFill" Margin="-12,0" Background="{ThemeResource NavActiveBrush}" Opacity="0"/>
                        <Border x:Name="Pill" Margin="-12,0,0,0" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{ThemeResource AccentBrush}" Opacity="0"/>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段选择：与按钮同尺寸，选中为主色实心 -->
    <Style x:Key="SegmentStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MiSansSemiboldFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                          CornerRadius="{StaticResource SoftControlCornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource ControlFillHoverBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource ControlFillPressedBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Selected.Opacity" Value="1"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextOnAccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Selected" Margin="-17,-1" CornerRadius="{StaticResource SoftControlCornerRadius}" Background="{ThemeResource AccentBrush}" Opacity="0"/>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 筛选胶囊 -->
    <Style x:Key="ChipStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Background" Value="{ThemeResource ChipFillBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CornerRadiusPill}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource ChipFillHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource ChipFillHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextOnAccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentHoverBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextOnAccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentPressedBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextOnAccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字链接按钮 -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CornerRadiusS}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource AccentSubtleBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource AccentSubtleBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片行标题旁的"查看全部 ›" -->
    <Style x:Key="RailLinkButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,4,6,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource CornerRadiusS}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillHoverBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillPressedBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroDotStyle" TargetType="Border">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="{ThemeResource TextTertiaryBrush}"/>
        <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style x:Key="HeroDotActiveStyle" TargetType="Border">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="{ThemeResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="HeroDotButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="3,9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Background="Transparent" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeroBadgeStyle" TargetType="Border">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusXS}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#E6FFFFFF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SkeletonBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SkeletonBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusL}"/>
    </Style>

    <!-- 小图标按钮：通知关闭、清除等 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ItemCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SubtleFillHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SubtleFillPressedBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片：整张可点击、可聚焦，没有按钮外观 -->
    <Style x:Key="CardButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="-4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片上的圆形播放钮：深色玻璃，悬停为主色 -->
    <Style x:Key="CardPlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="#8F101216"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="18" BorderBrush="#38FFFFFF" BorderThickness="1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource AccentBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource AccentPressedBrush}"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <FontIcon Glyph="&#xF5B0;" FontSize="14" Margin="2,0,0,0" Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片行两侧的翻页箭头 -->
    <Style x:Key="RailArrowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{ThemeResource PopupBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="18" BorderBrush="{ThemeResource PopupStrokeBrush}" BorderThickness="1"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Scale.ScaleX" Value="1.06"/>
                                        <Setter Target="Scale.ScaleY" Value="1.06"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PopupMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource PopupCornerRadius}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="MinWidth" Value="184"/>
    </Style>

    <!-- 弹出面：菜单、对话框、通知共用 -->
    <Style x:Key="PopupSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PopupBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource PopupStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PopupCornerRadius}"/>
    </Style>

    <!-- 设置行卡片 -->
    <Style x:Key="SettingCardColumnStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Spacing" Value="14"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource SoftControlCornerRadius}"/>
    </Style>
    <Style x:Key="SettingCardStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="ColumnSpacing" Value="16"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource SoftControlCornerRadius}"/>
    </Style>
</ResourceDictionary>
