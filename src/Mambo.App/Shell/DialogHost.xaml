<UserControl
    x:Class="Mambo.App.Shell.DialogHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <Grid x:Name="Scrim" Background="{ThemeResource ScrimBrush}" Tapped="OnScrimTapped">
        <Border x:Name="Panel" Style="{StaticResource PopupSurfaceStyle}" Width="400" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" TabFocusNavigation="Cycle"
                Tapped="OnPanelTapped" KeyDown="OnPanelKeyDown">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource BodyLargeStrongTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}"
                           LineHeight="20" TextWrapping="Wrap" TextTrimming="None"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SoftButtonStyle}" Click="OnCancelClick"/>
                    <Button x:Name="ConfirmButton" Style="{StaticResource SoftAccentButtonStyle}" Click="OnConfirmClick"/>
                    <Button x:Name="DangerButton" Style="{StaticResource DangerSoftButtonStyle}" Click="OnConfirmClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
