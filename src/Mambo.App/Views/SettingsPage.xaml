<UserControl
    x:Class="Mambo.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mambo.App.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeStrongTextStyle}">
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>
        <Style x:Key="SettingIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1080"/></Grid.ColumnDefinitions>
        <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="1080" HorizontalAlignment="Stretch">
            <controls:PageHeader Eyebrow="SETTINGS" Title="设置"/>

            <StackPanel Spacing="8" Margin="0,0,0,30">
                <TextBlock Style="{StaticResource GroupTitleStyle}" Text="服务器"/>
                <Grid Style="{StaticResource SettingCardStyle}" Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyLargeStrongTextStyle}" Foreground="{ThemeResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind ViewModel.AvatarText, Mode=OneWay}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="{x:Bind ViewModel.UserName, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind ViewModel.ConnectedServer, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasConnectedServer, Mode=OneWay}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource DangerSoftButtonStyle}" Click="OnDisconnectClick" AutomationProperties.Name="断开连接" IsEnabled="{x:Bind ViewModel.CanDisconnect, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xF3B1;" FontSize="14"/>
                            <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="{x:Bind ViewModel.DisconnectText, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Style="{StaticResource SettingCardColumnStyle}" Visibility="{x:Bind ViewModel.IsLoggedOut, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE774;"/>
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Text="连接 Emby 服务器"/>
                    </StackPanel>
                    <Grid Margin="36,0,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource BodySmallTextStyle}" FontFamily="{StaticResource MiSansSemiboldFontFamily}" FontWeight="SemiBold" Text="服务器地址"/>
                            <TextBox Style="{StaticResource SoftInputStyle}" PlaceholderText="https://your-emby-server" MaxLength="2048" IsSpellCheckEnabled="False"
                                     Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="服务器地址"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Style="{StaticResource BodySmallTextStyle}" FontFamily="{StaticResource MiSansSemiboldFontFamily}" FontWeight="SemiBold" Text="用户名"/>
                            <TextBox Style="{StaticResource SoftInputStyle}" PlaceholderText="用户名" MaxLength="256" IsSpellCheckEnabled="False"
                                     Text="{x:Bind ViewModel.LoginUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="用户名"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Style="{StaticResource BodySmallTextStyle}" FontFamily="{StaticResource MiSansSemiboldFontFamily}" FontWeight="SemiBold" Text="密码"/>
                            <PasswordBox x:Name="PasswordInput" Style="{StaticResource SoftPasswordStyle}" PlaceholderText="可以为空" KeyDown="OnPasswordKeyDown"
                                         AutomationProperties.Name="密码"/>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource SoftAccentButtonStyle}" MinWidth="96" VerticalAlignment="Bottom"
                                IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}" Content="{x:Bind ViewModel.ConnectText, Mode=OneWay}" Click="OnConnectClick"/>
                    </Grid>
                    <StackPanel Margin="36,0,0,0" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasLoginError, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarningBrush}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{x:Bind ViewModel.LoginError, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,0,0,30">
                <TextBlock Style="{StaticResource GroupTitleStyle}" Text="播放"/>
                <Grid Style="{StaticResource SettingCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE7F4;"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Text="播放方式"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <RadioButton Style="{StaticResource SegmentStyle}" GroupName="PlaybackMode" Content="内置播放器"
                                     IsChecked="{x:Bind ViewModel.IsEmbedded, Mode=OneWay}" Click="OnEmbeddedClick"/>
                        <RadioButton Style="{StaticResource SegmentStyle}" GroupName="PlaybackMode" Content="外部窗口"
                                     IsChecked="{x:Bind ViewModel.IsExternal, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanUseExternal, Mode=OneWay}" Click="OnExternalClick"/>
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource SettingCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE8A5;"/>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="外部 mpv 路径"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasMpvStatus, Mode=OneWay}">
                            <Grid>
                                <FontIcon Glyph="&#xE930;" FontSize="14" Foreground="{ThemeResource SuccessBrush}" Visibility="{x:Bind ViewModel.IsMpvOk, Mode=OneWay}"/>
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarningBrush}" Visibility="{x:Bind ViewModel.IsMpvWarning, Mode=OneWay}"/>
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind ViewModel.IsMpvInfo, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" MaxWidth="220" Text="{x:Bind ViewModel.MpvStatusText, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="2" ColumnSpacing="8" Width="480" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SoftInputStyle}" PlaceholderText="mpv.exe 路径" IsSpellCheckEnabled="False"
                                 IsEnabled="{x:Bind ViewModel.CanEditMpvPath, Mode=OneWay}" KeyDown="OnMpvKeyDown"
                                 Text="{x:Bind ViewModel.MpvPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="外部 mpv 路径"/>
                        <Button Grid.Column="1" Style="{StaticResource SoftButtonStyle}" Content="选择文件" Click="OnPickMpvClick" IsEnabled="{x:Bind ViewModel.CanEditMpvPath, Mode=OneWay}"/>
                        <Button Grid.Column="2" Style="{StaticResource SoftButtonStyle}" Content="验证并启用" Click="OnValidateMpvClick" IsEnabled="{x:Bind ViewModel.CanValidateMpv, Mode=OneWay}"/>
                    </Grid>
                </Grid>
                <Grid Style="{StaticResource SettingCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE706;"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Text="HDR"/>
                    <Button Grid.Column="2" Style="{StaticResource SoftButtonStyle}" MinWidth="150" Padding="14,0,12,0"
                            Foreground="{ThemeResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="HDR">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="{x:Bind ViewModel.HdrLabel, Mode=OneWay}"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12"/>
                        </Grid>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight" MenuFlyoutPresenterStyle="{StaticResource PopupMenuPresenterStyle}">
                                <RadioMenuFlyoutItem GroupName="Hdr" Text="自动" IsChecked="{x:Bind ViewModel.IsHdrAuto, Mode=OneWay}" Click="OnHdrAutoClick"/>
                                <RadioMenuFlyoutItem GroupName="Hdr" Text="始终 HDR" IsChecked="{x:Bind ViewModel.IsHdrAlways, Mode=OneWay}" Click="OnHdrAlwaysClick"/>
                                <RadioMenuFlyoutItem GroupName="Hdr" Text="关闭" IsChecked="{x:Bind ViewModel.IsHdrOff, Mode=OneWay}" Click="OnHdrOffClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Grid Style="{StaticResource SettingCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE950;"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Text="硬件解码"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <TextBlock Style="{StaticResource BodySmallTextStyle}" FontFamily="{StaticResource MiSansSemiboldFontFamily}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="{x:Bind ViewModel.HardwareDecodingText, Mode=OneWay}"/>
                        <ToggleSwitch x:Name="HardwareSwitch" MinWidth="0" OnContent="" OffContent="" IsOn="{x:Bind ViewModel.HardwareDecoding, Mode=OneWay}"
                                      Toggled="OnHardwareToggled" AutomationProperties.Name="硬件解码"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,0,0,30">
                <TextBlock Style="{StaticResource GroupTitleStyle}" Text="外观"/>
                <Grid Style="{StaticResource SettingCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE790;"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" Text="主题"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Theme" Content="跟随系统" IsChecked="{x:Bind ViewModel.IsThemeSystem, Mode=OneWay}" Click="OnThemeSystemClick"/>
                        <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Theme" Content="浅色" IsChecked="{x:Bind ViewModel.IsThemeLight, Mode=OneWay}" Click="OnThemeLightClick"/>
                        <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Theme" Content="深色" IsChecked="{x:Bind ViewModel.IsThemeDark, Mode=OneWay}" Click="OnThemeDarkClick"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,0,0,30">
                <TextBlock Style="{StaticResource GroupTitleStyle}" Text="关于"/>
                <Grid Style="{StaticResource SettingCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE946;"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Mambo"/>
                        <Border Height="20" Padding="8,0" CornerRadius="{StaticResource CornerRadiusPill}" Background="{ThemeResource ChipFillBrush}">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" FontFamily="{StaticResource MiSansMediumFontFamily}" FontWeight="Medium"
                                       LineHeight="20" Text="{x:Bind ViewModel.AppVersion}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SoftButtonStyle}" Click="OnLicensesClick" AutomationProperties.Name="第三方许可">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                            <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="第三方许可"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Style="{StaticResource SettingCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource SettingIconStyle}" Glyph="&#xE74D;"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="缓存"/>
                        <TextBlock Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource SoftButtonStyle}" Click="OnLogsClick" AutomationProperties.Name="打开日志目录" IsEnabled="{x:Bind ViewModel.CanOpenLogs, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14"/>
                                <TextBlock Style="{StaticResource ButtonLabelTextStyle}" Text="打开日志目录"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SoftButtonStyle}" Content="{x:Bind ViewModel.ClearCacheText, Mode=OneWay}" Click="OnClearCacheClick" IsEnabled="{x:Bind ViewModel.CanClearCache, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
