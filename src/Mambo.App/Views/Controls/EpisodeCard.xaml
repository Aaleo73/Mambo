<UserControl
    x:Class="Mambo.App.Views.Controls.EpisodeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:images="using:Mambo.App.Images"
    xmlns:themes="using:Mambo.App.Themes"
    Width="{StaticResource LandscapeWidth}">
    <Grid x:Name="Layout" Background="Transparent"
          GotFocus="OnFocusChanged" LostFocus="OnFocusChanged"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource LandscapeHeightGridLength}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Rest"/>
                <VisualState x:Name="Hover">
                    <VisualState.Setters>
                        <Setter Target="Stroke.BorderBrush" Value="{ThemeResource CardStrokeHoverBrush}"/>
                        <Setter Target="InnerStroke.Opacity" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Button x:Name="Root" Grid.RowSpan="2" Style="{StaticResource CardButtonStyle}" Click="OnClick" AutomationProperties.Name="{x:Bind Episode.Title, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource LandscapeHeightGridLength}"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Art" CornerRadius="{StaticResource LandscapeCornerRadius}" Background="{ThemeResource ImagePlaceholderBrush}">
                    <images:RemoteImage x:Name="Picture" Source="{x:Bind Episode.Image, Mode=OneWay}" DecodeWidth="{StaticResource LandscapeWidth}"
                                        CornerRadius="{StaticResource LandscapeCornerRadius}"/>
                    <Grid x:Name="Progress" Margin="8" Height="4" VerticalAlignment="Bottom" Visibility="{x:Bind Episode.HasProgress, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Episode.ProgressDone, Mode=OneWay}"/>
                            <ColumnDefinition Width="{x:Bind Episode.ProgressRest, Mode=OneWay}"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="3" VerticalAlignment="Bottom" CornerRadius="1.5" themes:SoftShadow.Kind="Progress"/>
                        <Border Height="3" VerticalAlignment="Bottom" CornerRadius="1.5" Background="#F5FFFFFF"/>
                    </Grid>
                    <Border x:Name="Stroke" CornerRadius="{StaticResource LandscapeCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeBrush}"/>
                    <Border x:Name="InnerStroke" Margin="1" CornerRadius="9" BorderThickness="1" BorderBrush="#1AFFFFFF" Opacity="0"/>
                    <!-- 选中：2px 中性深色环，里面衬 1px 反色细线，在任何剧照上都看得清 -->
                    <Grid Visibility="{x:Bind Episode.IsSelected, Mode=OneWay}">
                        <Border CornerRadius="{StaticResource LandscapeCornerRadius}" BorderThickness="2" BorderBrush="{ThemeResource CardSelectedStrokeBrush}"/>
                        <Border Margin="2" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardSelectedInnerBrush}"/>
                    </Grid>
                </Grid>
                <StackPanel x:Name="Copy" Grid.Row="1" Height="47" Margin="0,6,0,0" Spacing="6">
                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{x:Bind Episode.Title, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource CardSubtitleTextStyle}" Text="{x:Bind Episode.Subtitle, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Button>
        <Button x:Name="PlayButton" Grid.RowSpan="2" Style="{StaticResource CardPlayButtonStyle}" Margin="0,117,8,0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnPlayClick"
                AutomationProperties.Name="播放这一集" ToolTipService.ToolTip="播放这一集"/>
    </Grid>
</UserControl>
